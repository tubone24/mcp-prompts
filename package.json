{
  "name": "mcp-prompt",
  "version": "1.0.0",
  "description": "MCP server for prompt templates with TypeScript",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "dxt:build": "npm run build && node scripts/build-dxt.js",
    "dxt:package": "node scripts/package-dxt.js",
    "dxt:validate": "node scripts/validate-dxt.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "prompt-templates"
  ],
  "author": "tubone24<tubo.yyyuuu@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.29",
    "js-yaml": "^4.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "archiver": "^7.0.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.21.0",
    "vitest": "^2.1.8"
  }
}
